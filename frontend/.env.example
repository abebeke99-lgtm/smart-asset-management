# Browser-visible configuration only. Never put secrets in this file.
# Local development uses the CRA proxy configured in package.json.
# Production frontend should point to the public Railway backend base URL under /api.
# Do not set this to /api/health; health is only a monitoring endpoint.
REACT_APP_API_URL=https://smart-asset-management-3-production-9258.up.railway.app/api
REACT_APP_API_TIMEOUT=30000
