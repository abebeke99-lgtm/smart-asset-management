# Smart Asset Management Backend - Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=smart_asset_secret_key_2026

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_asset_db
DB_USER=root
DB_PASSWORD=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Database Synchronization
# Set to true only once to force recreate all tables (WARNING: will delete all data)
DB_SYNC_FORCE=false

# Logging
DB_LOGGING=false

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@smartasset.com

# File Upload
MAX_FILE_SIZE=10mb
UPLOAD_DIR=./uploads

# Session
SESSION_SECRET=session_secret_key_2026
SESSION_TIMEOUT=3600

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
