# Smart Asset Management Backend - Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# Required in production; the server refuses to start without it. Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional stable secret for local development; prevents tokens expiring on server restart.
JWT_DEV_SECRET=

# MySQL Database Configuration
# Production accepts DATABASE_URL/MYSQL_URL or DB_* / Railway MYSQL* variables.
# Local development defaults to localhost; production never falls back to localhost.
DATABASE_URL=
MYSQL_URL=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_asset_db
DB_USER=root
DB_PASSWORD=
# Railway MySQL service variables (used when the corresponding DB_* value is unset)
MYSQLHOST=
MYSQLPORT=
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_TIMEZONE=+00:00
DB_SYNC_ON_START=false

# Frontend URL and authorized origins (comma-separated for multiple domains)
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# Database Synchronization
# Set to true only once to force recreate all tables (WARNING: will delete all data)
DB_SYNC_FORCE=false

# Demo/Seed Accounts
# Required when SEED_DEMO_DATA=true. All seeded demo accounts share this password.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# Logging
DB_LOGGING=false

# Mail delivery mode: smtp for production, log for local dev/test mode.
MAIL_DRIVER=log
EMAIL_DRIVER=log
SMTP_DRIVER=log
# Email Configuration (Gmail uses implicit TLS on port 465 or STARTTLS on 587)
# Enable 2-Step Verification and use a Google App Password, not your account password.
# Set real values only in backend/.env or the backend hosting provider's environment.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=dev@example.com
EMAIL_PASSWORD=dev-secret
EMAIL_PASS=dev-secret
EMAIL_FROM="Mekdela Amba University" <dev@example.com>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev@example.com
SMTP_PASS=dev-secret
SMTP_FROM="Mekdela Amba University" <dev@example.com>
# SMTP_* names are supported as aliases; MAIL_FROM and SMTP_FROM are legacy sender aliases.
# SMTP timeouts in milliseconds. Every stage of the handshake is bounded so a
# stalled mail server can never leave a request (or a reset token) hanging.
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_DNS_TIMEOUT_MS=10000
SMTP_HARD_TIMEOUT_MS=30000
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RESET_OTP_TTL_MINUTES=5
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# SMS Configuration (Optional - for phone-based recovery)
# Use log for local dev/test mode. Real providers: twilio, africastalking
SMS_PROVIDER=log
SMS_PROVIDER_KEY=dev-provider-key
SMS_PROVIDER_SECRET=dev-provider-secret
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=SMARTASSET
SMS_SENDER=SMARTASSET

# File Upload
MAX_FILE_SIZE=10mb
UPLOAD_DIR=./uploads

# Session
SESSION_SECRET=
SESSION_TIMEOUT=3600

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
