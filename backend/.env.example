# Smart Asset Management Backend - Environment Configuration
# Copy this file to .env and update with your values

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
# Required in production; the server refuses to start without it. Generate with: openssl rand -hex 32
JWT_SECRET=
# Optional stable secret for local development; prevents tokens expiring on server restart.
JWT_DEV_SECRET=

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_asset_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Frontend URL and authorized origins (comma-separated for multiple domains)
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:5000/api

# Database Synchronization
# Set to true only once to force recreate all tables (WARNING: will delete all data)
DB_SYNC_FORCE=false

# Demo/Seed Accounts
# Required when SEED_DEMO_DATA=true. All seeded demo accounts share this password.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# Logging
DB_LOGGING=false

# Email Configuration (Optional - for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@your-university-domain.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@your-university-domain.edu
# SMTP_FROM is retained for backward compatibility; prefer MAIL_FROM.
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=20
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# SMS Configuration (Optional - for phone-based recovery)
SMS_PROVIDER=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=SMARTASSET

# File Upload
MAX_FILE_SIZE=10mb
UPLOAD_DIR=./uploads

# Session
SESSION_SECRET=
SESSION_TIMEOUT=3600

# API Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
