{
  "buildCommand": "CI=false npm install --prefix frontend && CI=false npm run build --prefix frontend",
  "outputDirectory": "frontend/build",
  "rewrites": [
    { "source": "/api", "destination": "https://smart-asset-management-3-production-9258.up.railway.app/api" },
    { "source": "/api/(.*)", "destination": "https://smart-asset-management-3-production-9258.up.railway.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}